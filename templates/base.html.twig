{% extends "@SurvosLanding/base.html.twig" %}

{% block javascripts %}
    {{ parent() }}
    {% block importmap %}{{ importmap(app) }}{% endblock %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}



{% block breadcrumbs %}
    <li>
        <a href="{{ path(easyadmin) }}">{{ ux_icon(home, {class: icon}) }} </a>
        <a href="{{ path(survos_landing) }}">Home</a>

        {% if is_granted(IS_AUTHENTICATED_FULLY) %}
            <a class="link" href="{{ path(app_logout) }}">Logout</a>
        {% else %}
            <a href="{{ path(user_registration) }}">Register</a>
            <a href="{{ path(app_login) }}">Login</a>
        {% endif %}


        <a href="{{ path(fcp_xml) }}">XML Files</a>
        |
    </li>

{% endblock %}

{% block fixed_header %}

{% endblock %}
{% block body %}
    <ul class="list-inline">
    {{ block(breadcrumbs) }}
    </ul>

    <div class="content">
        {{ block(content) }}
    </div>
{% endblock %}