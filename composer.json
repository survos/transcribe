{
    "name": "survos-sites/transcribe",
    "description": "Timecoded transcript selection and story export tools",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-simplexml": "*",
        "aws/aws-sdk-php": "^3.132",
        "doctrine/cache": "^1.8",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "easycorp/easyadmin-bundle": "^5.0",
        "mantas-done/subtitles": "^0.3.4",
        "mrmysql/youtube-transcript": "^0.0.5",
        "php-ffmpeg/php-ffmpeg": "^1.3",
        "servo/fluidxml": "^1.21",
        "soothsilver/dtd-parser": "^0.1.0",
        "symfony/apache-pack": "^1.0",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "^8.1",
        "symfony/dom-crawler": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/monolog-bundle": "^3.0|^4.0",
        "symfony/property-info": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/string": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/ux-icons": "*",
        "symfony/yaml": "^8.1",
        "twig/extra-bundle": "^3.0",
        "wapmorgan/media-file": "^0.1.4"
    },
    "require-dev": {
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.7",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.1.*"
        }
    }
}
